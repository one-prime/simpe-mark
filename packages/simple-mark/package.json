{
  "name": "simple-mark",
  "version": "0.1.0",
  "description": "Markdown that never hides its syntax: styling model, CodeMirror 6 editor and MathJax math (SVG).",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/one-prime/simple-mark.git"
  },
  "keywords": [
    "markdown",
    "wysiwyg",
    "editor",
    "codemirror",
    "mathjax",
    "gfm"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    "./model": {
      "types": "./dist/model.d.ts",
      "import": "./dist/model.js"
    },
    "./math": {
      "types": "./dist/math.d.ts",
      "import": "./dist/math.js"
    },
    "./codemirror": {
      "types": "./dist/codemirror.d.ts",
      "import": "./dist/codemirror.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "^1.5.3",
    "@lezer/markdown": "^1.8.1",
    "@mathjax/mathjax-newcm-font": "4.1.3",
    "@mathjax/src": "4.1.3"
  },
  "devDependencies": {
    "@simplemark/codemirror": "*",
    "@simplemark/math": "*",
    "@simplemark/model": "*",
    "tsdown": "^0.23.1"
  }
}
