{
  "name": "simplemark",
  "displayName": "SimpleMark",
  "description": "Edit Markdown with its formatting shown and none of its syntax hidden.",
  "version": "0.1.0",
  "publisher": "simplemark",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "wysiwyg",
    "editor",
    "math",
    "table"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "simplemark.editor",
        "displayName": "SimpleMark",
        "selector": [
          { "filenamePattern": "*.md" },
          { "filenamePattern": "*.markdown" }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "simplemark.open",
        "title": "Open with SimpleMark",
        "category": "SimpleMark",
        "icon": "$(preview)"
      },
      {
        "command": "simplemark.openAsText",
        "title": "Open as Text",
        "category": "SimpleMark",
        "icon": "$(go-to-file)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "simplemark.open",
          "when": "resourceLangId == markdown && activeCustomEditorId != simplemark.editor",
          "group": "navigation"
        },
        {
          "command": "simplemark.openAsText",
          "when": "activeCustomEditorId == simplemark.editor",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "simplemark.open",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "simplemark.open",
          "when": "resourceLangId == markdown && activeCustomEditorId != simplemark.editor"
        },
        {
          "command": "simplemark.openAsText",
          "when": "activeCustomEditorId == simplemark.editor"
        }
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs && vite build",
    "smoke": "node test/webview-smoke.mjs",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@simplemark/codemirror": "*",
    "@simplemark/model": "*",
    "@types/vscode": "~1.100.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1"
  }
}
